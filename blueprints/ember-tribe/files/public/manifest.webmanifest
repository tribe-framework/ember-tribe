{
  "name": "<%= classifiedPackageName %>",
  "short_name": "<%= classifiedPackageName %>",
  "description": "Built using ember-tribe.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#e9ecef",
